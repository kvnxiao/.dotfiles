<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>$title — interview whiteboard</title><style>$style</style></head><body>
<header class="chrome topbar"><div class="brand"><div class="brand-mark" aria-hidden="true">$mark</div><div><h1>$title</h1><p>$subtitle</p></div></div><div class="top-actions"><button id="notes-toggle" aria-pressed="true">Notes</button><button id="question-toggle" aria-expanded="false" aria-controls="question">Question ↗</button><button id="fullscreen" aria-label="Enter full screen">Full screen</button></div></header>
<main id="viewport" class="viewport" aria-label="Pannable interview whiteboard" title="Drag or middle-drag to pan. Shift+arrows pan with the keyboard. Wheel zooms canvas; Ctrl +/− zooms the browser."><div id="board" class="board">$board</div></main>
<aside id="question" class="question" aria-labelledby="question-label"><div class="question-head"><h2 id="question-label" tabindex="-1">Original question</h2><button id="question-close" aria-label="Close question">✕</button></div><div id="question-content" class="question-content" tabindex="0" aria-label="Full question text">$question</div></aside>
<footer class="chrome bottom"><div class="progress"><span id="counter" aria-live="polite"></span><label class="sr-only" for="step-select">Choose presentation step</label><select id="step-select">$options</select></div><div class="camera" role="group" aria-label="Canvas camera"><button id="zoom-out" aria-label="Zoom out">−</button><output id="zoom-label" aria-label="Zoom percentage">100%</output><button id="zoom-in" aria-label="Zoom in">+</button><button id="focus-step">Focus step</button><button id="fit-all">Fit all</button></div><nav class="nav" aria-label="Presentation navigation"><button id="previous" aria-label="Previous step" title="Previous step (Left arrow)">←</button><button id="next" class="primary" aria-label="Next step" title="Next step (Right arrow)">→</button></nav></footer>
<div id="status" class="sr-only" aria-live="polite"></div>
<script>$script</script></body></html>