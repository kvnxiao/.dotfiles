[Unit]
Description=NInfer Qwen3.8-27B NVFP4
Documentation=https://github.com/Neroued/ninfer
Wants=open-webui.service
Conflicts=vllm-qwen3.8.service vllm-gemma4.service

[Container]
ContainerName=ninfer-qwen3.8
Image=localhost/ninfer:local
Network=ai-net.network
NetworkAlias=ninfer
AddDevice=nvidia.com/gpu=all
PublishPort=8001:8080
HealthCmd=curl -fsS http://127.0.0.1:8080/health
HealthStartPeriod=600s
HealthInterval=30s
HealthRetries=3
Exec=ninfer-serve /models/artifact.ninfer \
  --host 0.0.0.0 \
  --port 8080 \
  --model-id qwen3.8-27b \
  --max-context 131072 \
  --kv-capacity auto \
  --kv-dtype fp8 \
  --max-concurrency 1 \
  --spec mtp \
  --draft-tokens 3 \
  --lm-head-draft \
  --preserve-thinking \
  --host-kv-mib 4096

[Service]
Restart=no
TimeoutStartSec=900
